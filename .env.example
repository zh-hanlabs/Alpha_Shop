# ShopAgent 环境变量示例
# 复制为 .env（已被 .gitignore 排除）或直接设置到系统环境变量
# 严禁把真实 Key 提交进仓库

# 聊天模型（当前接入 DeepSeek，OpenAI 兼容协议）
# AGENTS.md 规则 4：密钥只走系统环境变量，勿写入 .env / 任何文件
DEEPSEEK_API_KEY=sk-your-key-here

# W5 起向量/embedding 走 DashScope（DeepSeek 无 embedding 端点，双模型共存见 README）
AI_DASHSCOPE_API_KEY=sk-your-key-here

# —— W7D4 Compose 编排（compose.yml 与应用同读；下方均为本地演示默认值，可改）——
# MySQL 宿主侧端口（宿主 3306 常被本机 mysqld 占用，默认改挂 13306；容器内恒为 3306）
MYSQL_PORT=13306
MYSQL_DATABASE=shopagent
MYSQL_USERNAME=shopagent
MYSQL_PASSWORD=shopagent
MYSQL_ROOT_PASSWORD=root-shopagent
# T4.3 加分项 app 容器宿主侧端口（--profile fullstack 时生效）
APP_PORT=8080
